{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["webmplayer"],
  "ios": {
    "iosModuleName": "WebmPlayer"
  },
  "android": {
    "androidNamespace": ["webmplayer"],
    "androidCxxLibName": "WebmPlayer"
  },
  "autolinking": {
    "WebmPlayer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridWebmPlayer"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
