{
  "name": "@heartit/webm-player",
  "version": "2.0.0",
  "description": "Native WebM broadcast player for React Native — VP9 video + Opus audio with platform-owned A/V sync",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier . --write",
    "test": "prettier . --check && npm run lint",
    "lint:size": "node scripts/lint-size.js",
    "lint:pack": "node scripts/lint-pack.js",
    "test:asan": "cmake -B tests/build-asan -S tests -DSANITIZER=address && cmake --build tests/build-asan && sh tests/run-suites.sh tests/build-asan",
    "test:tsan": "cmake -B tests/build-tsan -S tests -DSANITIZER=thread && cmake --build tests/build-tsan && sh tests/run-suites.sh tests/build-tsan",
    "test:ubsan": "cmake -B tests/build-ubsan -S tests -DSANITIZER=undefined && cmake --build tests/build-ubsan && sh tests/run-suites.sh tests/build-ubsan",
    "test:native": "npm run test:asan && npm run test:tsan && npm run test:ubsan",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build && mkdir -p lib/nitrogen/generated/shared/json && cp nitrogen/generated/shared/json/*.json lib/nitrogen/generated/shared/json/",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build",
    "test:fuzz": "cmake -B tests/build-asan -S tests -DSANITIZER=address && cmake --build tests/build-asan --target fuzz_demuxer && ./tests/build-asan/fuzz_demuxer",
    "bundle:worklet": "bare-pack --preset mobile --format bundle --out worklet/dist/feeder.bundle worklet/feeder.js",
    "prepack": "npm run bundle:worklet",
    "test:worklet": "node node_modules/bare/bin/bare worklet/test/remux.test.js",
    "postinstall": "node scripts/link-bare-addons.js android && node scripts/link-bare-addons.js ios"
  },
  "keywords": [
    "react-native",
    "webm",
    "vp9",
    "opus",
    "nitro",
    "broadcast",
    "streaming"
  ],
  "files": [
    "src",
    "lib",
    "nitrogen",
    "cpp",
    "worklet/feeder.js",
    "worklet/remux.js",
    "worklet/dist",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "ios/opus/build-opus.sh",
    "!ios/opus/build",
    "!ios/opus/lib",
    "*.podspec",
    "README.md",
    "scripts/link-bare-addons.js"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heart-IT/react-native-webm-player.git"
  },
  "author": "Heartit Inc",
  "license": "Apache-2.0",
  "bugs": "https://github.com/heart-IT/react-native-webm-player/issues",
  "homepage": "https://github.com/heart-IT/react-native-webm-player#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/react": "^19.3.0",
    "bare": "^1.34.1",
    "bare-fs": "^4.8.3",
    "bare-os": "^3.9.3",
    "bare-pack": "^2.2.4",
    "bare-path": "^3.1.2",
    "brittle": "^4.5.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^9.39.5",
    "nitrogen": "^0.37.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-bare-kit": "^0.16.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-nitro-modules": "^0.37.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-bare-kit": ">=0.16.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@holepunchto/vcr-core": "^2.15.4",
    "bare-ffmpeg": "^1.2.2",
    "bare-link": "^4.0.1",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "hyperswarm": "^4.17.0"
  }
}
