{
  "name": "@heartit/webm-player",
  "version": "2.0.0",
  "description": "Native WebM broadcast player for React Native \u2014 VP9 video + Opus audio with platform-owned A/V sync",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier . --write",
    "test": "prettier . --check && npm run lint",
    "lint:size": "node scripts/lint-size.js",
    "lint:pack": "node scripts/lint-pack.js",
    "test:asan": "cmake -B tests/build-asan -S tests -DSANITIZER=address && cmake --build tests/build-asan && ./tests/build-asan/test_stream_buffer && ./tests/build-asan/test_e2e_demux && ./tests/build-asan/test_audit_proof && ./tests/build-asan/test_ring_registry && ./tests/build-asan/test_ring_lifetime && ./tests/build-asan/fuzz_demuxer",
    "test:tsan": "cmake -B tests/build-tsan -S tests -DSANITIZER=thread && cmake --build tests/build-tsan && ./tests/build-tsan/test_stream_buffer && ./tests/build-tsan/test_e2e_demux && ./tests/build-tsan/test_audit_proof && ./tests/build-tsan/test_ring_registry && ./tests/build-tsan/test_ring_lifetime && ./tests/build-tsan/fuzz_demuxer",
    "test:ubsan": "cmake -B tests/build-ubsan -S tests -DSANITIZER=undefined && cmake --build tests/build-ubsan && ./tests/build-ubsan/test_stream_buffer && ./tests/build-ubsan/test_e2e_demux && ./tests/build-ubsan/test_audit_proof && ./tests/build-ubsan/test_ring_registry && ./tests/build-ubsan/test_ring_lifetime && ./tests/build-ubsan/fuzz_demuxer",
    "test:native": "npm run test:asan && npm run test:tsan && npm run test:ubsan",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "npm run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && npm run build && node post-script.js",
    "test:fuzz": "cmake -B tests/build-asan -S tests -DSANITIZER=address && cmake --build tests/build-asan --target fuzz_demuxer && ./tests/build-asan/fuzz_demuxer"
  },
  "keywords": [
    "react-native",
    "webm",
    "vp9",
    "opus",
    "nitro",
    "broadcast",
    "streaming"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heart-IT/react-native-webm-player.git"
  },
  "author": "Heartit Inc",
  "license": "Apache-2.0",
  "bugs": "https://github.com/heart-IT/react-native-webm-player/issues",
  "homepage": "https://github.com/heart-IT/react-native-webm-player#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.18",
    "nitrogen": "^0.36.1",
    "react": "19.2.8",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "^0.36.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "semantic-release": "^25.0.7",
    "typescript": "^6.0.3",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
